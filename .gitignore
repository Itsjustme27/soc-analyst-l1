data/agent_stop.txt
data/*.jsonl
data/*.json
data/chroma/

# --- python ---
__pycache__/
*.py[cod]
venv/
.venv/
venv*/
# any throwaway test venv (.venv-cli-test, .venv-cli-test-20260926, ...) -
# these are ~400MB each and were previously NOT matched by the rules above
.venv*/
*.egg-info/
.pytest_cache/

# --- captured command output from manual/test runs ---
# *.out scratch files (suite_batches.out, mcp_repl.out, ...) piled up in the
# repo root because nothing claimed them
*.out

# --- coverage / static analysis artifacts ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.bandit_cache/
.pytest_cache/
.mypy_cache/

# --- data dir (runtime artifacts) ---
data/*
!data/.gitkeep

# --- OS / editor / misc ---
.DS_Store
Thumbs.db
*.swp
*.log
!tests/fixtures/sample_events/*.log
nohup.out

# --- local DBs ---
*.db
*.sqlite3
