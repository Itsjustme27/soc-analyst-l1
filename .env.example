# --- LLM provider ---
# Which LLM backend to use: anthropic | openai | google | mock | freellmapi
#   anthropic   = Claude (default)
#   openai      = any OpenAI-compatible /chat/completions endpoint - OpenAI,
#                 OpenRouter, Ollama, vLLM, LM Studio, DeepSeek, ... via OPENAI_BASE_URL
#   google      = Google Gemini
#   freellmapi  = unified-key gateway to dozens of free LLM providers
#                 (https://freellmapi.co) - one key, automatic routing/fallover
#   mock        = deterministic offline provider for dev/CI with NO API key.
#                 It replays a scripted triage per alert type instead of reasoning.
LLM_PROVIDER=anthropic

# Anthropic
#ANTHROPIC_API_KEY=sk-ant-xxxxx
#ANTHROPIC_MODEL=            # optional - falls back to AGENT_MODEL

# OpenAI-compatible (OpenAI / OpenRouter / Ollama / vLLM / DeepSeek / ...)
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=               # e.g. gpt-4o - optional, falls back to AGENT_MODEL

# Google Gemini
#GOOGLE_API_KEY=...
#GOOGLE_MODEL=               # e.g. gemini-2.0-flash - optional, falls back to AGENT_MODEL

# FreeLLMAPI (LLM_PROVIDER=freellmapi)
# Paste your unified API key from the FreeLLMAPI dashboard (Keys page) here.
# The gateway is OpenAI-compatible and handles model routing + fallover for you.
#FREELLMAPI_API_KEY=freellmapi-xxxxx
#FREELLMAPI_BASE_URL=http://localhost:3001/v1   # default (self-hosted gateway)
#FREELLMAPI_MODEL=auto        # 'auto' lets the gateway pick; or auto:fast / auto:smart / a model id

# Generic default model - used by any provider that doesn't set its own
# <PROVIDER>_MODEL above.
AGENT_MODEL=claude-sonnet-4-6

# --- SIEM platform (alert source) ---
# Which SIEM platform to pull alerts from by default:
#   splunk | qradar | elastic | sentinel | mock
# You can connect to more instances of any platform at runtime via the
# dashboard (python dashboard.py -> "Add provider"); those connections are
# stored in data/siem_providers.json.
SIEM_PROVIDER=splunk

# Splunk
SPLUNK_HOST=https://splunk.yourcorp.local:8089
SPLUNK_TOKEN=your-splunk-hec-or-bearer-token
SPLUNK_VERIFY_SSL=true
# Saved search / notable event index to pull from
SPLUNK_SEARCH="search index=notable status=new | head 20"

# IBM QRadar
#QRADAR_HOST=https://qradar.yourcorp.local
#QRADAR_TOKEN=your-qradar-api-token
#QRADAR_VERIFY_SSL=true
# Ariel query that surfaces your alerts (default: every event in the last hour)
#QRADAR_SEARCH="SELECT * FROM events LAST 1 HOUR"

# Elastic Security
#ELASTIC_HOST=https://elastic.yourcorp.local:9200
#ELASTIC_API_KEY=base64-elastic-api-key
#ELASTIC_VERIFY_SSL=true
#ELASTIC_INDEX=.siem-signals-*

# Microsoft Sentinel
#SENTINEL_TENANT_ID=azure-tenant-id
#SENTINEL_CLIENT_ID=app-client-id
#SENTINEL_CLIENT_SECRET=app-client-secret
#SENTINEL_WORKSPACE_ID=log-analytics-workspace-id
#SENTINEL_QUERY=SecurityAlert | where TimeGenerated > ago(1h) | take 20

# Wazuh (deploy with docker compose in ./wazuh - indexer on localhost:9200)
# The indexer speaks OpenSearch; default creds are admin/admin on a fresh
# docker deployment. Self-signed TLS by default -> WAZUH_VERIFY_SSL=false.
# For verify on, point WAZUH_CA_CERT at wazuh/config/wazuh_indexer_ssl_certs/root-ca.pem
#WAZUH_HOST=https://localhost:9200
#WAZUH_USERNAME=admin
#WAZUH_PASSWORD=admin
#WAZUH_INDEX=wazuh-alerts-*
#WAZUH_RELATED_INDEX=wazuh-archives-*    # raw events for correlation lookups
#WAZUH_VERIFY_SSL=false
#WAZUH_CA_CERT=wazuh/config/wazuh_indexer_ssl_certs/root-ca.pem   # when VERIFY_SSL=true

# --- Wazuh manager REST API (AI SOC engineer: rules/decoders/logtest/agents) ---
# The manager API (default port 55000) is a DIFFERENT surface from the indexer
# above. The bundled docker stack creates the `wazuh-wui` user with a generated
# password - see wazuh/docker-compose.yml (API_USERNAME/API_PASSWORD). All
# write operations via the AI SOC engineer go through this API behind an
# approval gate; it is never used for destructive actions without approval.
#WAZUH_API_URL=https://localhost:55000
#WAZUH_API_USERNAME=wazuh-wui
#WAZUH_API_PASSWORD=MyS3cr37P450r.*-
#WAZUH_API_VERIFY_SSL=false
#WAZUH_API_CA_CERT=wazuh/config/wazuh_api_ssl_certs/root-ca.pem     # when VERIFY_SSL=true

# --- Wazuh dashboard / OpenSearch Dashboards (AI dashboard engineer) ---
# Used for creating/verifying dashboards + visualizations via the saved-objects
# API. Best-effort: if unreachable, the engineer reports a clean error instead
# of fabricating success.
#WAZUH_DASHBOARD_URL=https://localhost:443
#WAZUH_DASHBOARD_USERNAME=admin
#WAZUH_DASHBOARD_PASSWORD=admin
#WAZUH_DASHBOARD_VERIFY_SSL=false

# --- AI SOC engineer: tool layer limits & gates ---
#ENGINE_USER=analyst                  # who audit/proposals are attributed to
#AUDIT_LOG_PATH=data/audit_log.jsonl  # every tool invocation is logged here
#APPROVALS_PATH=data/approvals.json   # approval center store
#TOOL_QUERY_SIZE_LIMIT=200            # hard cap on rows a tool may pull
#TOOL_RESULT_SIZE_LIMIT=50            # hard cap on rows returned to the LLM/UI
#TOOL_QUERY_TIMEOUT=20                # seconds before a tool call times out
#LOGTEST_MAX_ATTEMPTS=3               # auto-correction attempts for generated rules
#APPROVAL_EXPIRY_SECONDS=86400        # pending proposals expire after this long
#APPROVAL_EXECUTION_WINDOW_SECONDS=0  # approved proposal must be claimed within N seconds (0 = no limit)
#APPROVAL_PROPOSE_MIN_APPROVERS=1     # quorum before a PROPOSE-level proposal is approved
#APPROVAL_EXECUTE_MIN_APPROVERS=1     # quorum before an EXECUTE-level proposal is approved
#ENGINE_MAX_TOOL_TURNS=10             # tool-use budget per engineer conversation

# Mock SIEM (SIEM_PROVIDER=mock) - optional override of the canned alerts file
#MOCK_SIEM_ALERTS_FILE=./seed_data/mock_alerts.json

# Where the dashboard stores extra SIEM provider connections (JSON list)
SIEM_PROVIDERS_PATH=./data/siem_providers.json

# --- CrowdStrike Falcon (enrichment / EDR) ---
FALCON_CLIENT_ID=your-client-id
FALCON_CLIENT_SECRET=your-client-secret
FALCON_BASE_URL=https://api.crowdstrike.com

# --- Agent behavior ---
# Below this confidence (0-1), always escalate to human instead of auto-closing
AUTO_CLOSE_CONFIDENCE_THRESHOLD=0.9
# If true, agent NEVER calls containment actions (isolate host/disable user) - recommends only
DRY_RUN_ACTIONS=true
# Use mock SIEM + CrowdStrike connectors instead of live APIs - for testing
# the agent + RAG + self-improvement loop before wiring real credentials.
MOCK_MODE=false

# --- Lookup tables, agent rules & chat/engineer logs ---
LOOKUP_TABLES_PATH=data/lookup_tables.json
CHAT_LOG_PATH=data/chat_log.jsonl        # triage-agent /api/chat transcripts
ENGINEER_LOG_PATH=data/engineer_log.jsonl  # AI SOC engineer /api/engineer/chat transcripts
# Local correlation/filtering rules evaluated before LLM triage (rules.py).
#RULES_PATH=data/rules.json
#RULE_STATE_PATH=data/rule_state.json    # rolling window counters for threshold/grouping rules

# --- Rule-triggered notifications (rules.py action.notify) ---
# Webhook that receives a JSON POST when a rule fires with action.notify set.
# Empty = notifications are logged but never sent.
NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_SECONDS=10                # webhook call timeout
NOTIFICATIONS_LOG_PATH=data/notifications.jsonl

# --- Web search / OSINT (disabled by default — off keeps triage fully offline) ---
WEB_SEARCH_ENABLED=false
SEARXNG_URL=  # optional: self-hosted SearXNG instance (e.g., http://localhost:8080)
# Every query is logged: the query string leaves the building, and the
# analyst runs unattended, so an injected instruction could otherwise cause
# internal hostnames or indicators to be sent to a third party with no record of it.
WEB_QUERY_LOG_PATH=data/web_queries.jsonl

# --- LLM retry/backoff (FreeLLMAPI / OpenRouter free tiers throw 429s under load) ---
LLM_MAX_RETRIES=5
LLM_RETRY_BACKOFF_BASE=1.5  # seconds
LLM_RETRY_BACKOFF_MAX=30    # cap per-step max wait (also caps huge Retry-After headers)
LLM_429_MAX_RETRIES=2       # 429s are rate-limit signals: far fewer retries than 5xx,
                            # and Retry-After is honored before bounded exponential backoff
LLM_TRACE_REQUESTS=true     # one structured JSON line per LLM attempt (request_id/attempt/
                            # model/status/latency/usage/retry_after) on logger 'soc.llm'
                            # API keys and prompt contents are never logged.

# FreeLLMAPI fallback: after a rate-limit failure, ONE extra attempt with an
# explicit alternate model (different provider family, from the gateway's own
# /v1/models list). Only fires on failure - the happy path is unchanged.
#FREELLMAPI_FALLBACK_ENABLED=true
#FREELLMAPI_FALLBACK_MODELS_TTL=300   # seconds to cache the model list

# Chat agent tool-loop budget: max LLM calls per /api/chat message. The loop
# returns immediately when the model answers without a tool call, so this is a
# hard ceiling, not the typical call count.
#LLM_MAX_TOOL_TURNS=8

# --- Overnight watcher (run.py) / dashboard agent control ---
AGENT_STOP_FILE=data/agent_stop.txt        # write this file to ask the watcher to stop
AGENT_HEARTBEAT_PATH=data/agent_heartbeat.json  # watcher updates this each cycle
AGENT_POLL_INTERVAL=30                     # seconds between polls (default --interval)
# One watcher deployment (working dir + own log) lives in its own subdir here:
#AGENT_DIR=data/agents
#AGENT_LOG_FILE=data/agent_run.log         # captured stdout/stderr (default watcher)

# --- Dashboard (python dashboard.py) ---
# Optional auth. Off by default - fine for strictly local use bound to
# 127.0.0.1, but set a token BEFORE binding --host to anything else: every
# /api/* route (SIEM writes, watcher start/stop, rules/lookup CRUD, the
# approval center) is otherwise wide open.
#DASHBOARD_TOKEN=change-me
# Optional per-user tokens: "user:token[:role],user:token[:role],...".
# Roles: viewer (reads) | approver (reads + approval center) | admin (everything).
# A per-user Bearer token maps to a VERIFIED identity; the approval center
# then ignores any client-supplied "by" (separation of duties).
#DASHBOARD_USERS=analyst:sekrit:approver,admin:sekrit2

# --- Audit / triage logs ---
TRIAGE_LOG_PATH=data/triage_log.jsonl

# --- Rendered dashboard preview PNGs (matplotlib, Agg backend - headless) ---
# Served by token name only; see tools/dashboard/preview.py.
PREVIEW_DIR=data/previews

# --- Storage / RAG ---
CHROMA_DB_PATH=./data/chroma
FEEDBACK_LOG_PATH=./data/feedback_log.jsonl
# Embedding mode for the knowledge base: auto | hashing | chroma.
# auto = chroma in MOCK_MODE, hashing fallback otherwise. hashing = fully
# offline token-feature vectors (no model download). Only set explicitly if
# you know you want to pin one.
#KB_EMBEDDING_MODE=auto
