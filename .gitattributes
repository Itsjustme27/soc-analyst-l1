# Normalize line endings & exports across checkouts.
* text=auto eol=lf

# Binary/lock artifacts from the tooling
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.whl binary
*.tar.gz binary

# These must never acquire CRLF or stray markers
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
.yaml text eol=lf
*.sh text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

# Linguistics: mark generated/derivative files so diffs stay reviewable
CHANGELOG.md linguist-generated=false